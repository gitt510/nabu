                  },
                  "prs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https:\\/\\/[^\\s/?#]+"
                    },
                    "uniqueItems": true
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https:\\/\\/[^\\s/?#]+"
                    },
                    "uniqueItems": true
                  },
                  "situation": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 45,
                      "pattern": "\\S"
                    }
                  },
                  "complication": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 45,
                      "pattern": "\\S"
                    }
                  },
                  "question": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 45,
                      "pattern": "\\S"
                    }
                  },
                  "answer": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 45,
                      "pattern": "\\S"
                    }
                  },
                  "why_dropped": {
                    "type": "array",

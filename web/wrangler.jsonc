{
  // Serves the viewer: the page from dist/ as static assets, built on deploy, and its data from D1,
  // where /api/tasks, the API the CLI talks to, keeps every task.
  // The data lives only in the database, never in the repo or the Worker.
  // Access (sign-in) is set on the Worker in the Zero Trust dashboard, not here; the Worker checks the token
  // Access signs against CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD, which just deploy and just preview pass with --var
  // from 1Password (docs/config.md).
  "name": "nabu",
  "main": "src/index.ts",
  "assets": { "directory": "dist" },
  // Pinned on purpose: a moving date would change the Worker's behavior silently.
  "compatibility_date": "2026-10-11",
  // Schema changes are files in migrations/, applied with `wrangler d1 migrations apply nabu`.
  "d1_databases": [{ "binding": "DB", "database_name": "nabu", "database_id": "b56c5b0a-b0d0-41bc-a686-ee0a69dc41fc" }],
  // Version preview URLs sit behind the same Access application as workers.dev, so `just preview` can share one.
  "preview_urls": true
}

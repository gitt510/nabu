{
  // Serves the viewer: the page from dist/ as static assets, built on deploy, and its data from R2, which the publish workflow uploads.
  // Also serves /api/tasks from D1, the store the CLI and the viewer are moving to.
  // The data lives only in the bucket and the database, never in the repo or the Worker.
  // Access (sign-in) is set on the Worker in the Zero Trust dashboard, not here.
  "name": "nabu",
  "main": "src/index.ts",
  "assets": { "directory": "dist" },
  // Pinned on purpose: a moving date would change the Worker's behavior silently.
  "compatibility_date": "2026-10-11",
  "r2_buckets": [{ "binding": "VIEW", "bucket_name": "nabu" }],
  // Schema changes are files in migrations/, applied with `wrangler d1 migrations apply nabu`.
  "d1_databases": [{ "binding": "DB", "database_name": "nabu", "database_id": "b56c5b0a-b0d0-41bc-a686-ee0a69dc41fc" }],
  // Version preview URLs would sit outside Access.
  "preview_urls": false
}
